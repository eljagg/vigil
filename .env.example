# Copy this file to .env for local development.
# In Railway, set these as environment variables in the service settings.
#
# Required
# --------
SECRET_KEY=change-me-to-a-64-char-hex-string-using-secrets-token-hex-32
DATABASE_URL=postgresql+psycopg://vigil:vigil@localhost:5432/vigil

# Optional — features that work in production but are off in development
# ----------------------------------------------------------------------
# Object storage for company logos. If unset, logos fall back to a local
# path inside the container — fine for dev, NOT fine for Railway since
# the container filesystem is ephemeral.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# Optional — branding defaults (admins can override in the UI later)
# ------------------------------------------------------------------
COMPANY_NAME=Your Company
TAGLINE=Backup integrity check.
FOOTER_CREDIT=Designed by Omar McLeod - 2026

# Optional — security knobs
# -------------------------
# Force HTTPS-only cookies. Auto-on in production; leave blank for local dev.
SESSION_COOKIE_SECURE=
# Idle session timeout in minutes
SESSION_TIMEOUT_MINUTES=60
# Max login attempts per minute per IP before rate-limiting kicks in
LOGIN_RATE_LIMIT=5 per minute

# Optional — LDAP / Active Directory (disabled until enabled in admin UI)
# ----------------------------------------------------------------------
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_BIND_USER_TEMPLATE={username}@example.com
